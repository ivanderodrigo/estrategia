      "cache_ttl_s": 21600,
      "ted_lookback_days": 10,
      "checkpoint_every": 20
    },
    "deep": {
      "entity_limit": 520,
      "pages_per_entity": 16,
      "request_timeout_s": 9,
      "retries": 3,
      "cache_ttl_s": 86400,
      "ted_lookback_days": 35,
      "checkpoint_every": 20
    },
    "exhaustive": {
      "entity_limit": 1400,
      "pages_per_entity": 32,
      "request_timeout_s": 12,
      "retries": 4,
      "cache_ttl_s": 172800,
      "ted_lookback_days": 100,
