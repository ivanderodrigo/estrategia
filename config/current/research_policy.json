{
  "version": 4,
  "profiles": {
    "daily": {
      "entity_limit": 160,
      "pages_per_entity": 6,
      "request_timeout_s": 7,
      "retries": 2,
      "cache_ttl_s": 21600,
      "ted_lookback_days": 10,
      "checkpoint_every": 20
    },
    "deep": {
      "entity_limit": 700,
      "pages_per_entity": 20,
      "request_timeout_s": 9,
      "retries": 3,
      "cache_ttl_s": 86400,
      "ted_lookback_days": 35,
      "checkpoint_every": 20
    },
    "exhaustive": {
      "entity_limit": 1800,
      "pages_per_entity": 40,
      "request_timeout_s": 12,
      "retries": 4,
      "cache_ttl_s": 172800,
      "ted_lookback_days": 100,
      "checkpoint_every": 15
    }
  },
  "source_cascade": [
    "existing_evidence",
    "historical_claim_exact_revalidation",
    "official_routes",
    "official_partner_locators_and_directories",
    "official_certifications_and_partner_levels",
    "official_cases_and_customer_stories",
    "official_investor_relations_and_annual_reports",
    "official_careers_and_job_portals",
    "official_marketplaces_and_service_catalogues",
    "sitemap",
    "relevant_internal_links",
    "query_discovery_multilingual",
    "portfolio_procurement_relevance_gate",
    "systematic_source_lanes",
    "spain_official_procurement",
    "portugal_official_procurement",
    "ted_search_api",
    "public_analyst_material",
    "sector_associations_and_channel_press",
    "corroborated_external_candidates"
  ],
  "languages": [
    "es",
    "pt",
    "en"
  ],
  "adaptive_depth": true,
  "max_response_bytes": 3000000,
  "blocked_networks": "private, loopback, link-local, multicast and reserved",
  "diminishing_returns_stop": {
    "minimum_passes": 6,
    "zero_yield_passes": 4
  },
  "job_signal_policy": "technology in job posting is SIGNAL only; never partnership confirmation",
  "no_public_evidence_policy": "a gap remains open and retains attempt history",
  "entity_growth_policy": "structured TED growth is bounded per research profile; unstructured external entities remain candidates until corroborated",
  "atomic_provenance_policy": "each list value carries only its own evidence",
  "discovery_evidence_separation": "discovery sources route the next step but cannot close a claim until an accrediting source supports the same subject and value",
  "historical_priority": "claims with historical lineage and no Westcon document or current public evidence receive an explicit priority multiplier",
  "public_procurement": {
    "spain": [
      "Plataforma de Contratación del Sector Público",
      "BOE",
      "official contracting profiles"
    ],
    "portugal": [
      "BASE",
      "Diário da República",
      "official contracting profiles"
    ],
    "europe": [
      "TED"
    ]
  },
  "structured_growth_limits": {
    "daily": 24,
    "deep": 100,
    "exhaustive": 220
  },
  "research_roi_policy": {
    "enabled": true,
    "principle": "close valuable debt before expanding breadth; transport success is not intelligence success",
    "primary_metrics": [
      "accepted_evidence_per_fetch_attempt",
      "candidate_acceptance_rate",
      "values_per_accepted_evidence",
      "structured_entities_added",
      "low_context_public_gaps",
      "public_validation_gaps"
    ],
    "low_context_public_tier_ceiling": "P2"
  },
  "query_discovery": {
    "enabled": true,
    "principle": "search engines discover candidate URLs only; every discovered page must still pass the canonical evidence gates",
    "providers": [
      "bing_rss",
      "duckduckgo_html"
    ],
    "budgets": {
      "daily": {
        "max_entities": 72,
        "queries_per_entity": 6,
        "results_per_query": 8
      },
      "deep": {
        "max_entities": 500,
        "queries_per_entity": 14,
        "results_per_query": 12
      },
      "exhaustive": {
        "max_entities": 1200,
        "queries_per_entity": 20,
        "results_per_query": 15
      }
    },
    "discovery_only": true,
    "no_api_key_required": true,
    "note": "Upper bounds only: supervisor deadline, safety and evidence gates remain authoritative; sources are discovery only."
  },
  "debt_aware_growth": {
    "enabled": true,
    "pause_above_gaps": 12000,
    "minimum_growth_under_debt": {
      "daily": 6,
      "deep": 18,
      "exhaustive": 36
    },
    "principle": "When unsupported debt is high, sharply restrict growth but keep a small stream of new high-fit procurement intelligence. Never add generic commodity notices merely to increase entity counts."
  },
  "systematic_discovery": {
    "enabled": true,
    "principle": "Search every research target across independent, source-specific lanes. These queries discover candidate URLs only; no snippet or search hit is evidence.",
    "lanes": {
      "spain_channel_press": [
        "channelpartner.es",
        "itreseller.es",
        "computing.es"
      ],
      "portugal_channel_press": [
        "itchannel.pt"
      ],
      "cybersecurity_media": [
        "revistasic.es",
        "redseguridad.com"
      ],
      "technology_research": [
        "idc.com",
        "omdia.tech.informa.com",
        "deloitte.com",
        "pwc.es"
      ],
      "public_procurement": [
        "contrataciondelestado.es",
        "base.gov.pt",
        "ted.europa.eu"
      ],
      "cyber_security_public": [
        "incibe.es",
        "ccn-cert.cni.es",
        "cncs.gov.pt"
      ]
    },
    "rotate_across_runs": true,
    "max_domain_queries_per_target": {
      "daily": 3,
      "deep": 7,
      "exhaustive": 10
    }
  },
  "procurement_relevance": {
    "principle": "Surface procurement only when the published need has explicit fit with Westcon Iberia networking, cybersecurity, cloud, data-center, observability, identity or automation domains.",
    "include_terms": [
      "cybersecurity",
      "cyber security",
      "ciberseguridad",
