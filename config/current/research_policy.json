      "entity_limit": 120,
      "pages_per_entity": 5,
      "request_timeout_s": 7,
      "retries": 2,
      "cache_ttl_s": 21600,
      "ted_lookback_days": 10,
      "checkpoint_every": 20
    },
    "deep": {
      "entity_limit": 520,
      "pages_per_entity": 16,
      "request_timeout_s": 9,
      "retries": 3,
      "cache_ttl_s": 86400,
      "ted_lookback_days": 35,
