  "job_signal_policy": "technology in job posting is SIGNAL only; never partnership confirmation",
  "no_public_evidence_policy": "a gap remains open and retains attempt history",
  "entity_growth_policy": "structured TED notices promote automatically; unstructured external entities require corroboration before promotion",
  "atomic_provenance_policy": "each list value carries only its own evidence"
}
