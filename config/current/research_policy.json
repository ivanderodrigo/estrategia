    },
    "exhaustive": {
      "entity_limit": 1400,
      "pages_per_entity": 32,
      "request_timeout_s": 12,
      "retries": 4,
      "cache_ttl_s": 172800,
      "ted_lookback_days": 100,
      "checkpoint_every": 15
    }
