  "profiles": {
    "daily": {
      "description": "Cambios rápidos: canal, partners, clientes, M&A, producto, noticias y contratación reciente.",
      "budgets": {
        "query_limit_brave": 260,
        "query_limit_no_brave": 110,
        "news_queries_max": 150,
        "gdelt_queries_max": 110,
        "arquivo_queries_max": 24,
        "sitemap_pages_max": 260,
        "ecosystem_sitemap_pages_max": 220,
        "analyst_sitemap_pages_max": 90,
        "ted_vendor_limit": 14,
        "full_procurement": false,
        "carryover_days": 540
      }
    },
    "deep": {
      "description": "Investigación profunda: todos los vendors, ecosistema, analistas, contratación ES/PT, canal, competencia, servicios y gaps.",
      "budgets": {
        "query_limit_brave": 1200,
        "query_limit_no_brave": 360,
        "news_queries_max": 420,
        "gdelt_queries_max": 320,
        "arquivo_queries_max": 130,
        "sitemap_pages_max": 2600,
        "ecosystem_sitemap_pages_max": 1800,
        "analyst_sitemap_pages_max": 320,
        "ted_vendor_limit": 80,
        "full_procurement": true,
        "carryover_days": 1095
      }
    }
  },
  "change_detection": {
    "enabled": true,
    "new_relation_min_confidence": 70,
    "material_coverage_delta": 8,
    "conflict_terms": [
      "termination",
      "terminated",
      "ends distribution",
      "distribution ends",
      "ceases distribution",
      "fin de distribución",
      "deja de distribuir",
      "ya no distribuye",
      "fim da distribuição",
      "deixa de distribuir"
    ]
  },
  "relationship_validation": {
    "verified_threshold": 82,
    "strong_candidate_threshold": 70,
    "require_country_precision_for_verified": true,
    "prefer_primary_sources": true
