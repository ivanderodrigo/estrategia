{
  "version": "3.4.0",
  "recommendations": {
    "max_published": 32,
    "act_fact_min": 0.82,
    "act_interpretation_min": 0.68,
    "act_risk_max": 0.35,
    "require_linked_evidence": true,
    "require_primary_for_act": true
  },
  "adaptive_research": {
    "tier_weights": {"T1": 1.0, "T2": 0.72, "T3": 0.38},
    "priority_formula": {
      "tier": 0.30,
      "knowledge_gap": 0.25,
      "westcon_relevance": 0.16,
      "staleness": 0.12,
      "business_value": 0.12,
      "source_success_probability": 0.05
    },
    "failed_source_behavior": "cooldown_and_continue",
    "negative_search_results_are_recorded": true
  },
  "relationship_governance": {
    "statuses": ["CONFIRMED", "PROBABLE", "RESEARCH PRIORITY", "INSUFFICIENT EVIDENCE"],
    "separate_status_intensity_confidence": true,
    "absence_of_evidence_is_not_absence": true,
    "evidence_deduplication": "URL; fallback title + source + date"
  },
  "economics": {
    "mode": "relative_only",
    "forbid_forecast_without_internal_data": true,
    "future_inputs": ["ventas", "margen", "pipeline", "rebates", "renewals", "attach", "partner base", "certificaciones", "headcount", "coste de enablement"]
  },
  "source_hierarchy": ["primary", "secondary-quality", "aggregator"],
  "paid_analyst_policy": "Use only public metadata, press releases, public summaries and licensed user-supplied excerpts; never reconstruct paid reports."
}
